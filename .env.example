# Copy this file to .env and fill in real values. Never commit .env itself
# (it's gitignored) - only this placeholder template belongs in version control.

# Alpaca paper-trading API credentials (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true

# Telegram bot supervisor (Stage 9b, telegram_bot.py) - remote notifications
# and start/stop/status control over the automation daemon.
# TELEGRAM_BOT_TOKEN: create a bot via @BotFather on Telegram, copy the
#   token it gives you (looks like "123456789:AAExampleTokenTextGoesHere").
# TELEGRAM_CHAT_ID: your own chat id - message your new bot once, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates to find "chat":{"id": ...}.
# Every command is checked against this chat id; messages from any other
# chat are silently ignored.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
